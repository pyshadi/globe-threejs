{
  "name": "globe-threejs",
  "version": "1.0.1",
  "description": "A 3D globe visualization using Three.js with dynamic lighting and timezone calculations.",
  "main": "src/globe.js",
  "scripts": {
    "start": "node src/globe.js",
    "build": "webpack --config webpack.config.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "https://cdn\\.skypack\\.dev/three@[^\"]+": "<rootDir>/__mocks__/three.js",
      "https://cdn\\.skypack\\.dev/@turf/turf@[^\"]+": "@turf/turf"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyshadi/globe-threejs.git"
  },
  "keywords": [
    "threejs",
    "globe",
    "3D",
    "visualization"
  ],
  "author": "Shadi Alhaj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pyshadi/globe-threejs/issues"
  },
  "homepage": "https://github.com/pyshadi/globe-threejs#readme",
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "three": "^0.167.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0"
  }
}

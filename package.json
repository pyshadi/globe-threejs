{
  "name": "globe-threejs",
  "version": "3.0.1",
  "description": "A 3D globe visualization using Three.js with dynamic lighting and timezone calculations.",
  "type": "module",
  "main": "./src/globe.js",
  "types": "./src/globe.d.ts",
  "exports": {
    ".": {
      "types": "./src/globe.d.ts",
      "default": "./src/globe.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pyshadi/globe-threejs.git"
  },
  "keywords": [
    "threejs",
    "globe",
    "3D",
    "visualization"
  ],
  "author": "Shadi Alhaj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pyshadi/globe-threejs/issues"
  },
  "homepage": "https://github.com/pyshadi/globe-threejs#readme",
  "files": [
    "src",
    "assets/earth-day-4k.jpg",
    "assets/earth-night-4k.jpg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@photostructure/tz-lookup": "^11.6.1"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/three": "^0.167.2",
    "three": "^0.167.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
